    </name>
    <questiontext format="html">
      <text>&lt;p&gt;¿Qué memoria adicional usa el buffer compartido?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html">
      <text>&lt;p&gt;El buffer reserva una posición por elemento.&lt;/p&gt;</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>EST_2.1.3_2</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Θ(n)</text>
      <feedback format="html">
        <text>El buffer reserva una posición por elemento.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Θ(1)</text>
