  <question type="multichoice">
    <name>
      <text>2.1.3-01 Merge Sort</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;¿Qué decisión conserva estabilidad en la mezcla?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html">
      <text>&lt;p&gt;La mitad izquierda mantiene el orden original entre iguales.&lt;/p&gt;</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>EST_2.1.3_1</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Elegir la izquierda en un empate</text>
      <feedback format="html">
        <text>La mitad izquierda mantiene el orden original entre iguales.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Elegir siempre la derecha</text>
      <feedback format="html">
        <text>La mitad izquierda mantiene el orden original entre iguales.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Descartar una clave repetida</text>
      <feedback format="html">
        <text>La mitad izquierda mantiene el orden original entre iguales.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
