  <question type="multichoice">
    <name>
      <text>3.3.2-01 Grafos y recorridos</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;¿Cuándo BFS da distancia mínima en número de aristas?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html">
      <text>&lt;p&gt;BFS explora por capas de aristas.&lt;/p&gt;</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>EST_3.3.2_1</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>En un grafo sin pesos</text>
      <feedback format="html">
        <text>BFS explora por capas de aristas.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Con cualquier peso negativo</text>
      <feedback format="html">
        <text>BFS explora por capas de aristas.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Solo si es un árbol</text>
      <feedback format="html">
        <text>BFS explora por capas de aristas.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>3.3.2-02 Grafos y recorridos</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;¿Cuándo se marca un vértice en BFS?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html">
      <text>&lt;p&gt;Así se evita encolarlo repetidamente.&lt;/p&gt;</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>EST_3.3.2_2</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Al encolarlo</text>
      <feedback format="html">
        <text>Así se evita encolarlo repetidamente.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Solo al acabar todo el grafo</text>
      <feedback format="html">
        <text>Así se evita encolarlo repetidamente.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Nunca en grafos no dirigidos</text>
      <feedback format="html">
        <text>Así se evita encolarlo repetidamente.</text>
      </feedback>
    </answer>
