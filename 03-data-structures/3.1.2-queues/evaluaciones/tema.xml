    </name>
    <questiontext format="html">
      <text>&lt;p&gt;¿Qué diferencia FIFO de LIFO?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html">
      <text>&lt;p&gt;FIFO preserva orden de llegada.&lt;/p&gt;</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>EST_3.1.2_1</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Retira el primer elemento ingresado</text>
      <feedback format="html">
        <text>FIFO preserva orden de llegada.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Retira siempre el mayor</text>
      <feedback format="html">
        <text>FIFO preserva orden de llegada.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Retira el último ingresado</text>
      <feedback format="html">
        <text>FIFO preserva orden de llegada.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
