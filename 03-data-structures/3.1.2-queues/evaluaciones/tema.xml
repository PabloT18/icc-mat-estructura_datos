    </name>
    <questiontext format="html">
      <text>&lt;p&gt;¿Dónde se inserta en la cola circular descrita?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html">
      <text>&lt;p&gt;El módulo permite reutilizar posiciones liberadas.&lt;/p&gt;</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>EST_3.1.2_2</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>(head+size) mod C</text>
      <feedback format="html">
        <text>El módulo permite reutilizar posiciones liberadas.</text>
      </feedback>
