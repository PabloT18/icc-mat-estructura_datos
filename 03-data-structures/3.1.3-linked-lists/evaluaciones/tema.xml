  <question type="multichoice">
    <name>
      <text>3.1.3-01 Listas enlazadas</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;¿Cuánto cuesta buscar un valor en una lista simple?&lt;/p&gt;</text>
    </questiontext>
    <generalfeedback format="html">
      <text>&lt;p&gt;Puede ser necesario recorrer todos los nodos.&lt;/p&gt;</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>EST_3.1.3_1</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Θ(n) en el peor caso</text>
      <feedback format="html">
        <text>Puede ser necesario recorrer todos los nodos.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Siempre Θ(1)</text>
      <feedback format="html">
        <text>Puede ser necesario recorrer todos los nodos.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Θ(log n) sin condiciones</text>
      <feedback format="html">
        <text>Puede ser necesario recorrer todos los nodos.</text>
      </feedback>
    </answer>
  </question>
