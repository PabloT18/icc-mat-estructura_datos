    <hidden>0</hidden>
    <idnumber>EST_1.1_1</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>Θ(n)</text>
      <feedback format="html">
        <text>El término lineal domina y existen cotas lineales inferior y superior.</text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text>Θ(n²)</text>
